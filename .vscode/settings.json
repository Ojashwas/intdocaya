    "/^node --version; npm --version$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^npm run build$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "az": true,
    "npm test": true,
    "git add": true
  },
