{
  "name": "docaya",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <27",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "cross-env DOCAYA_ENV=development AUTH_MODE=development LOCAL_SQLITE_ENABLED=true node --env-file-if-exists=.env server/app/index.mjs",
    "api": "node --env-file-if-exists=.env server/app/index.mjs",
    "start": "node server/app/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/accessibility",
    "test:load": "k6 run tests/load/documents.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "infra:build": "az bicep build --file infra/main.bicep --stdout > NUL",
    "db:migrate": "node server/db/migrate-postgres.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/monitor-opentelemetry": "1.19.0",
    "jose": "6.2.10",
    "lucide-react": "0.544.0",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.1",
    "@types/pg": "8.15.5",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "cross-env": "10.0.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
